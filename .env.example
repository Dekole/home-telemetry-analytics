# Copy this file to .env and fill in values before running docker-compose up

# Set to true to use mock camera events and loop demo.mp4 instead of live camera
DEMO_MODE=true

# PostgreSQL connection string — matches the db service in docker-compose.yml
DATABASE_URL=postgresql://hta:hta@db:5432/hta

# MediaMTX internal API — host.docker.internal resolves to the Docker host
# (mediamtx runs with --network=host, so it binds directly to host ports)
MEDIAMTX_INTERNAL_URL=http://host.docker.internal:9997

# Live camera credentials — used by pytapo (HTTP API)
CAMERA_IP=
CAMERA_USER=
CAMERA_PASSWORD=

# RTSP camera account — created in Tapo app > Settings > Advanced Settings > Camera Account
RTSP_USER=
RTSP_PASSWORD=
